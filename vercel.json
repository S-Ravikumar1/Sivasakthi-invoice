{
  "version": 2,
  "builds": [
    {
      "src": "api-invoices.js",
      "use": "@vercel/node"
    },
    {
      "src": "api-next-invoice-number.js",
      "use": "@vercel/node"
    },
    {
      "src": "api-health.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/invoices",
      "dest": "/api-invoices.js"
    },
    {
      "src": "/api/next-invoice-number",
      "dest": "/api-next-invoice-number.js"
    },
    {
      "src": "/api/health",
      "dest": "/api-health.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
